# Copy to .env (Docker) or add the same names under Vercel -> Project -> Settings -> Environment Variables.
# Never commit real keys.

# --- scheduled refresh (GitHub Actions / Vercel Cron send this as a Bearer token) ---
CRON_SECRET=a-long-random-string
# Sign-in uses accounts: the first start creates  admin / admin  - change it at once.

# --- data sources ---
ODDS_API_KEY=          # free: https://the-odds-api.com  (Starter plan)
ODDSPAPI_KEY=          # free: https://oddspapi.io       (250 requests/month)
API_SPORTS_KEY=        # https://dashboard.api-football.com/register
ODDS_API_IO_KEY=       # paid: https://odds-api.io (Danske Spil / Eurobet)

# --- phone alerts (optional) ---
TELEGRAM_BOT_TOKEN=

# --- email (optional): lets BetFinder email temporary passwords to new users ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=an "app password" (Google account -> Security -> App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- storage on Vercel: added automatically when you connect Upstash Redis ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Docker/VPS only ---
DOMAIN=bets.example.com
