# Copy to .env and fill in. Never commit .env.
DOMAIN=bets.example.com
# Required when the site is public: the app asks for this once per browser.
BETFINDER_TOKEN=change-me-to-a-long-random-string
# Data sources (all optional; keys can also be entered in the app under Sources)
ODDS_API_KEY=
API_SPORTS_KEY=
ODDS_API_IO_KEY=
ODDSPAPI_KEY=
# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
