# BetFinder environment variables. Full list and explanations: SETUP.md, section 7.
#
#   Docker:  copy to .env - docker compose reads it automatically.
#   Locally: copy to .env and start with  uvicorn main:app --env-file .env
#            (or leave keys empty here and paste them in the app under More -> Sources & settings).
#   Vercel:  add the same names under Project -> Settings -> Environment Variables.
#
# Never commit the real .env (it is git-ignored).
# Sign-in uses accounts: the first start creates  admin / admin  - change the password at once.

# --- scheduled refresh: required for /api/cron/refresh (GitHub Actions / Vercel Cron send it as a Bearer token) ---
# generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- data sources ---
ODDS_API_KEY=          # free: https://the-odds-api.com  (Starter plan, 500 credits/month)
ODDSPAPI_KEY=          # free: https://oddspapi.io       (250 requests/month)
API_SPORTS_KEY=        # https://dashboard.api-football.com/register (free plan = past seasons only)
ODDS_API_IO_KEY=       # paid: https://odds-api.io (Danske Spil / Eurobet)

# --- phone alerts (optional; the chat id / ntfy topic are set in the app) ---
TELEGRAM_BOT_TOKEN=

# --- email (optional): lets BetFinder email temporary passwords to new users ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASSWORD=an "app password" (Google account -> Security -> App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- storage: leave empty to use JSON files in data/runtime ---
# Vercel adds these automatically when you connect Upstash Redis:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# or any standard Redis server:
# REDIS_URL=rediss://default:password@host:port
# BETFINDER_DATA_DIR=data          # local data folder (files go in <folder>/runtime)

# --- optional defaults for app settings (changes made in the app still win) ---
# BETFINDER_SCRAPER_MODE=fallback   # off | fallback | always
# BETFINDER_AUTO_REFRESH_MINUTES=60

# --- Docker/VPS only ---
DOMAIN=bets.example.com
