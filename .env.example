# Copy to .env (Docker) or add the same names under Vercel -> Project -> Settings -> Environment Variables.
# Never commit real keys.

# --- access protection (recommended when the site is public) ---
BETFINDER_TOKEN=change-me-to-a-long-random-string
CRON_SECRET=another-long-random-string

# --- data sources ---
ODDS_API_KEY=          # free: https://the-odds-api.com  (Starter plan)
ODDSPAPI_KEY=          # free: https://oddspapi.io       (250 requests/month)
API_SPORTS_KEY=        # https://dashboard.api-football.com/register
ODDS_API_IO_KEY=       # paid: https://odds-api.io (Danske Spil / Eurobet)

# --- phone alerts (optional) ---
TELEGRAM_BOT_TOKEN=

# --- storage on Vercel: added automatically when you connect Upstash Redis ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Docker/VPS only ---
DOMAIN=bets.example.com
